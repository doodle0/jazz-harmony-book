	import DeviceAB from '#lib/widgets/DeviceAB.svelte';
	import Hear from '#lib/widgets/Hear.svelte';
	import Heard from '#lib/components/Heard.svelte';
	import Quiz from '#lib/components/Quiz.svelte';
